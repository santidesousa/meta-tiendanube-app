# =============================================================
# Acceso al panel
# =============================================================
# Contraseña de la agencia: ve todo y puede conectar cuentas (/dashboard/conexiones)
ADMIN_PASSWORD=
# Contraseña del cliente (Tout Revient): solo lectura
DASHBOARD_PASSWORD=
# Opcional: secreto para firmar sesiones. Si no se define, se deriva de las
# contraseñas (cambiar una contraseña cierra todas las sesiones).
SESSION_SECRET=

# =============================================================
# Meta (Facebook/Instagram Ads)
# =============================================================
# https://developers.facebook.com/apps -> tu app -> Configuracion basica
META_APP_ID=tu_app_id
META_APP_SECRET=tu_app_secret
# Debe coincidir EXACTO con lo registrado en "Valid OAuth Redirect URIs"
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_SCOPES=ads_read,business_management
# Cuenta publicitaria del panel. El servidor rechaza cualquier otra cuenta
# aunque el token tenga acceso.
META_AD_ACCOUNT_ID=act_1487373418081023
# Token con el que el panel lee Meta para todos los usuarios. Se obtiene en
# /dashboard/conexiones despues de conectar (o, mejor, un token de usuario
# del sistema de Business Manager, que no vence).
META_ACCESS_TOKEN=

# =============================================================
# Tiendanube
# =============================================================
# https://www.tiendanube.com/partners al crear tu app
TIENDANUBE_CLIENT_ID=tu_client_id
TIENDANUBE_CLIENT_SECRET=tu_client_secret
TIENDANUBE_REDIRECT_URI=http://localhost:3000/api/auth/tiendanube/callback
# Tienda y token de Tout Revient (se copian desde /dashboard/conexiones).
# Con TIENDANUBE_STORE_ID configurado el panel rechaza cualquier otra tienda.
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=

# =============================================================
# Google Analytics 4 (cuenta de servicio: no vence)
# =============================================================
# Id numerico de la propiedad (GA4 -> Administrar -> Detalles de la propiedad)
GA_PROPERTY_ID=
# Contenido COMPLETO del archivo .json de la clave de la cuenta de servicio.
# La cuenta de servicio tiene que estar agregada como "Lector" en la propiedad.
GA_SERVICE_ACCOUNT_JSON=

# =============================================================
# Negocio y marca
# =============================================================
# Margen bruto promedio en % (lo que queda de cada venta despues del costo de
# la mercaderia). Se usa para la ganancia despues de publicidad y el ROAS de
# equilibrio. Si no se define se usa 50.
GROSS_MARGIN=
# Nombre de la agencia que aparece en el menu (opcional)
NEXT_PUBLIC_AGENCY_NAME=

# URL base de la app (cambia en produccion)
APP_URL=http://localhost:3000
