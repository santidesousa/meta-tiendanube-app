# --- Meta (Facebook/Instagram Ads) ---
# Obtene estos valores en https://developers.facebook.com/apps -> tu app -> Configuracion basica
META_APP_ID=tu_app_id
META_APP_SECRET=tu_app_secret
# Debe coincidir EXACTO con lo que registres en "Valid OAuth Redirect URIs"
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# Permisos (scopes) que vas a pedir. Para leer/gestionar campanas:
META_SCOPES=ads_management,ads_read,business_management

# --- Tiendanube ---
# Obtene estos valores en https://www.tiendanube.com/partners al crear tu app
TIENDANUBE_CLIENT_ID=tu_client_id
TIENDANUBE_CLIENT_SECRET=tu_client_secret
TIENDANUBE_REDIRECT_URI=http://localhost:3000/api/auth/tiendanube/callback

# URL base de tu app (cambia en produccion)
APP_URL=http://localhost:3000
